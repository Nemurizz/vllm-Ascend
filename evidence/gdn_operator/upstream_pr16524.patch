From 378aed93737ef2ff5c20a077c0271797b2f1c9b6 Mon Sep 17 00:00:00 2001
From: Mlight7 <88367366+Mlight7@users.noreply.github.com>
Date: Mon, 14 Sep 2026 19:01:46 +0800
Subject: [PATCH] perf(gdn): skip conversion for suppressed outputs

Avoid dtype and layout conversion of h and v_new when the configured suppression level discards both intermediates. Preserve the existing conversion and return behavior for suppression level 3 and above.

Signed-off-by: Mlight7 <88367366+Mlight7@users.noreply.github.com>
---
 vllm_ascend/ops/triton/fla/chunk.py | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/vllm_ascend/ops/triton/fla/chunk.py b/vllm_ascend/ops/triton/fla/chunk.py
index 6c3e289e039f..a937f510154e 100644
--- a/vllm_ascend/ops/triton/fla/chunk.py
+++ b/vllm_ascend/ops/triton/fla/chunk.py
@@ -209,12 +209,11 @@ def chunk_gated_delta_rule_fwd(
     )
 
     o = o_ascendc.to(torch.bfloat16).transpose(1, 2).contiguous()
-    v_new = v_new.to(torch.bfloat16).transpose(1, 2).contiguous()
-    h = h.to(torch.bfloat16).transpose(1, 2).contiguous()
-
     if SUPPRESS_LEVEL < 3:
         return g, o, A, final_state, None, None, None
     elif SUPPRESS_LEVEL >= 3:
+        v_new = v_new.to(torch.bfloat16).transpose(1, 2).contiguous()
+        h = h.to(torch.bfloat16).transpose(1, 2).contiguous()
         return g, o, A, final_state, w, h, v_new
 
 
